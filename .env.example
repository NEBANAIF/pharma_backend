# Reference only -- Spring Boot reads these from the container's real
# environment variables (set them in Render's dashboard, not as a file).
#
# Neon's "Connection string" page gives you host/db/user/password; build
# the JDBC URL from those pieces, keeping sslmode=require (Neon requires
# SSL, and won't accept plain connections).
#
# IMPORTANT: include the port (:5432) explicitly. The app's backup/restore
# feature (BackupService) parses this URL with a regex that requires
# host:port/db -- Neon's copy-paste connection string omits the port
# (it's implied), so add it back in or that feature fails at startup.
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>:5432/<db-name>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-username>
SPRING_DATASOURCE_PASSWORD=<neon-password>

# Leave as 'update' so Hibernate creates/updates tables on Neon
# automatically on first boot -- see DEPLOYMENT.md for why this means
# you don't need to run the migration_*.sql files anywhere.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Long random string -- e.g. `openssl rand -base64 48`
PMS_JWT_SECRET=

# Your Netlify site URL(s), comma-separated, no trailing slash
PMS_CORS_ALLOWED_ORIGINS=https://your-app.netlify.app

# --- First-run bootstrap ---
# /api/auth/register is open (no auth needed) ONLY while the users table
# is completely empty -- see BootstrapGuard.java. Use it once, via Postman,
# to create your first ADMIN account:
#
#   POST https://<your-render-url>/api/auth/register
#   Content-Type: application/json
#   {
#     "username": "admin",
#     "password": "choose-a-strong-password",
#     "fullName": "Administrator",
#     "roleName": "ADMIN"
#   }
#
# The moment that call succeeds, the endpoint permanently locks back down
# to ADMIN-only -- no env vars needed for this, nothing to configure here.
